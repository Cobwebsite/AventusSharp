import { VoidWithError, ResultWithError } from '../../Tools/ResultWithError.lib.avt';
import { SharpClass } from '../../Data/SharpClass.lib.avt';

namespace Data {

	export enum DataErrorCode {
		DefaultDMGenericType,
		DMOnlyForceInherit,
		TypeNotStorable,
		TypeTooMuchStorable,
		GenericNotAbstract,
		ParentNotAbstract,
		InfiniteLoop,
		InterfaceNotUnique,
		SelfReferecingDependency,
		DMNotExist,
		DMAlreadyExist,
		MethodNotFound,
		StorageDisconnected,
		StorageNotFound,
		NoConnectionInsideStorage,
		TypeNotExistInsideStorage,
		UnknownError,
		NoItemProvided,
		NoTransactionInProgress,
		WrongType,
		NoTypeIdentifierFoundInsideQuery,
		ItemNoExistInsideStorage,
		ItemAlreadyExist,
		ValidationError,
		GetAllNotAllowed,
		GetByIdNotAllowed,
		GetByIdsNotAllowed,
		WhereNotAllowed,
		CreateNotAllowed,
		UpdateNotAllowed,
		DeleteNotAllowed,
		NumberOfItemsNotMatching,
		FieldTypeNotFound,
		MemberNotFound,
		TooMuchMemberFound,
		TypeNotFound,
		ReverseLinkNotExist,
		ReverseLinkExist,
		ErrorCreatingReverseQuery,
		LinkNotSet,
		MultipleProvidersNotSet,
		FileNotFound,
		PyramidNotFound,
		IsReadOnly,
		ReverseLinkNotPrepared,
		ExternalStorageNotPrepared
	}

	@Convertible()
	export class DataError extends Aventus.GenericError<typeof DataErrorCode>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Data.DataError, AventusSharp.Core"; }
	}

	@Convertible()
	export class VoidWithDataError extends VoidWithError<DataError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Data.VoidWithDataError, AventusSharp.Core"; }
	}

	@Convertible()
	export class ResultWithDataError<T> extends ResultWithError<T, DataError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Data.ResultWithDataError, AventusSharp.Core"; }
	}

	@Convertible()
	export class FieldErrorInfo extends SharpClass  {
		/** Fullname of the class */
		public static get Fullname(): string { return "AventusSharp.Data.FieldErrorInfo, AventusSharp.Core"; }
		public Name!: string;
	}

}