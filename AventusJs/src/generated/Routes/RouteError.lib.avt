import { VoidWithError, ResultWithError } from '../../Tools/ResultWithError.lib.avt';

namespace Routes {

	export enum RouteErrorCode {
		UnknownError,
		FormContentTypeUnknown,
		CantGetValueFromBody,
		CantMoveFile,
		CantCreateFolders,
		RouteAlreadyExist,
		ConfigError
	}

	@Convertible()
	export class RouteError extends Aventus.GenericError<typeof RouteErrorCode>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Routes.RouteError, AventusSharp.Core"; }
	}

	@Convertible()
	export class VoidWithRouteError extends VoidWithError<RouteError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Routes.VoidWithRouteError, AventusSharp.Core"; }
	}

	@Convertible()
	export class ResultWithRouteError<T> extends ResultWithError<T, RouteError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.Routes.ResultWithRouteError, AventusSharp.Core"; }
	}

}