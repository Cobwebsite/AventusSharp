import { ResultWithError, VoidWithError } from "../../Tools/ResultWithError.lib.avt";

namespace SSE {

	export enum SSEErrorCode {
		UnknownError,
		CantDefineAssembly,
		ConfigError,
		MultipleMainEndpoint,
		CantGetValueFromBody,
		NoEndPoint
	}

	@Convertible()
	export class SSEError extends Aventus.GenericError<typeof SSEErrorCode>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.SSE.SSEError, AventusSharp.AspNetCore"; }
	}

	@Convertible()
	export class VoidWithSSEError extends VoidWithError<SSEError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.SSE.VoidWithSSEError, AventusSharp.AspNetCore"; }
	}

	@Convertible()
	export class ResultWithSSEError<T> extends ResultWithError<T, SSEError>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "AventusSharp.SSE.ResultWithSSEError, AventusSharp.AspNetCore"; }
	}

}