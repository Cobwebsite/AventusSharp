<Project>
  <!-- Opt in with AventusMessageCatalog items; no executable or extra package required. -->
  <UsingTask TaskName="AventusGenerateMessageKeys" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Catalog ParameterType="System.String" Required="true" />
      <Namespace ParameterType="System.String" Required="true" />
      <ClassName ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>

      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var identifier = new Regex(@"^[A-Za-z_][A-Za-z0-9_]*$");
        var namespaceParts = Namespace.Split('.');
        if (!namespaceParts.All(p => identifier.IsMatch(p)) || !identifier.IsMatch(ClassName))
        {
            Log.LogError("Invalid message key namespace or class name: {0}.{1}", Namespace, ClassName);
            return false;
        }
        var keys = XDocument.Load(Catalog).Root.Elements("data")
            .Select(e => (string)e.Attribute("name")).OrderBy(k => k, StringComparer.Ordinal).ToArray();
        if (keys.Any(k => k == null || !k.Split('.').All(p => identifier.IsMatch(p))) ||
            keys.Distinct(StringComparer.Ordinal).Count() != keys.Length)
        {
            Log.LogError("Message keys must be unique dot-separated C# identifiers in {0}.", Catalog);
            return false;
        }
        var code = new StringBuilder("// <auto-generated/>\n");
        code.Append("namespace ").Append(string.Join(".", namespaceParts.Select(p => "@" + p))).Append("\n{\n");
        code.Append("public static class @").Append(ClassName).Append("\n{\n");
        Action<string[], int, string> emit = null;
        emit = (items, depth, parent) =>
        {
            foreach (var group in items.GroupBy(k => k.Split('.')[depth]))
            {
                var leaf = group.Where(k => k.Split('.').Length == depth + 1).ToArray();
                if (group.Key == parent || (leaf.Length > 0 && group.Count() > 1))
                {
                    Log.LogError("Message key '{0}' conflicts with a containing class or key group.", group.First());
                    continue;
                }
                if (leaf.Length > 0)
                    code.Append("public const string @").Append(group.Key).Append(" = \"").Append(leaf[0]).Append("\";\n");
                else
                {
                    code.Append("public static class @").Append(group.Key).Append("\n{\n");
                    emit(group.ToArray(), depth + 1, group.Key);
                    code.Append("}\n");
                }
            }
        };
        emit(keys, 0, ClassName);
        code.Append("}\n}\n");
        if (Log.HasLoggedErrors) return false;
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        var content = code.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
            File.WriteAllText(OutputFile, content, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateAventusMessageKeys" BeforeTargets="CoreCompile" Condition="'@(AventusMessageCatalog)' != ''">
    <AventusGenerateMessageKeys Catalog="%(AventusMessageCatalog.FullPath)"
        Namespace="%(AventusMessageCatalog.Namespace)" ClassName="%(AventusMessageCatalog.ClassName)"
        OutputFile="$(IntermediateOutputPath)AventusMessageKeys/%(AventusMessageCatalog.Namespace).%(AventusMessageCatalog.ClassName).g.cs" />
    <ItemGroup>
      <Compile Include="@(AventusMessageCatalog->'$(IntermediateOutputPath)AventusMessageKeys/%(Namespace).%(ClassName).g.cs')" />
      <FileWrites Include="@(AventusMessageCatalog->'$(IntermediateOutputPath)AventusMessageKeys/%(Namespace).%(ClassName).g.cs')" />
    </ItemGroup>
  </Target>
</Project>

