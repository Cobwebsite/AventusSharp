import { Storable } from "../Storable.data.avt";
import { RamCompletor } from "./RamCompletor.lib.avt";
import type { Request as HttpRequest } from "../generated/Routes/Request/Request.lib.avt";
import type { Resource } from "../Routes/Response/Resource.lib.avt";
import type { StorableWsRouter } from "../WebSocket/StorableWsRouter.lib.avt";
import { ResultWithError, VoidWithError } from "../Tools/ResultWithError.lib.avt";
import { Ram, RamError, RamErrorCode, uuidv4, type ExtractFromError, type KeysObject, type RamItem, type UriParamsValue } from "Aventus@Main:Aventus.package.avt";

namespace RAM {
    export type RamWebSocketListenOnStart = {
        GetAll: boolean,
        GetById: boolean,
        Create: boolean,
        CreateMany: boolean,
        Update: boolean,
        UpdateMany: boolean,
        Delete: boolean,
        DeleteMany: boolean,
    };
    export abstract class RamWebSocket<
        Item extends Storable,
        Request extends HttpRequest | Item = Item,
        ResourceSimple extends Resource | Item = Item,
        ResourceDetails extends ResourceSimple = ResourceSimple,
    > extends Ram<Item, Request, ResourceSimple, ResourceDetails> {
        protected getAllDone: boolean = false;
        private routes: StorableWsRouter<Item, Request, ResourceSimple, ResourceDetails>;
        protected otherGetAllLocked: { [uid: string]: true; } = {};
        protected otherGetByIdLocked: { [uid: string]: true; } = {};
        protected otherCreateItemLocked: { [uid: string]: true; } = {};
        protected otherCreateListLocked: { [uid: string]: true; } = {};
        protected otherUpdateItemLocked: { [uid: string]: true; } = {};
        protected otherUpdateListLocked: { [uid: string]: true; } = {};
        protected otherDeleteItemLocked: { [uid: string]: true; } = {};
        protected otherDeleteListLocked: { [uid: string]: true; } = {};


        public abstract defineRoutes(): StorableWsRouter<Item, Request, ResourceSimple, ResourceDetails>;

        protected constructor() {
            super();
            this.routes = this.defineRoutes();
            this.addEventsBindings();
        }

        protected override addOrUpdateData(item: ResourceDetails | ExtractFromError<ResourceDetails> | ResourceSimple | ExtractFromError<ResourceSimple>): Promise<ResultWithError<{ kind: "created" | "updated"; value: RamItem<ResourceDetails, Request>; }>> {
            return super.addOrUpdateData(item as ResourceDetails);
        }

        protected addEventsBindings() {
            const autoListen = this.listenOnStart();

            this.routes.events.GetAll.onTrigger.add(this.otherGetAll, this);
            if(autoListen.GetAll) {
                this.routes.events.GetAll.listen();
            }
            else {
                this.routes.events.GetAll.stop();
            }

            this.routes.events.GetById.onTrigger.add(this.otherGetById, this);
            if(autoListen.GetById) {
                this.routes.events.GetById.listen();
            }
            else {
                this.routes.events.GetById.stop();
            }

            this.routes.events.Create.onTrigger.add(this.otherCreateItem, this);
            if(autoListen.Create) {
                this.routes.events.Create.listen();
            }
            else {
                this.routes.events.Create.stop();
            }

            this.routes.events.CreateMany.onTrigger.add(this.otherCreateList, this);
            if(autoListen.CreateMany) {
                this.routes.events.CreateMany.listen();
            }
            else {
                this.routes.events.CreateMany.stop();
            }

            this.routes.events.Update.onTrigger.add(this.otherUpdateItem, this);
            if(autoListen.Update) {
                this.routes.events.Update.listen();
            }
            else {
                this.routes.events.Update.stop();
            }

            this.routes.events.UpdateMany.onTrigger.add(this.otherUpdateList, this);
            if(autoListen.UpdateMany) {
                this.routes.events.UpdateMany.listen();
            }
            else {
                this.routes.events.UpdateMany.stop();
            }

            this.routes.events.Delete.onTrigger.add(this.otherDeleteItem, this);
            if(autoListen.Delete) {
                this.routes.events.Delete.listen();
            }
            else {
                this.routes.events.Delete.stop();
            }

            this.routes.events.DeleteMany.onTrigger.add(this.otherDeleteList, this);
            if(autoListen.DeleteMany) {
                this.routes.events.DeleteMany.listen();
            }
            else {
                this.routes.events.DeleteMany.stop();
            }
        }

        protected listenOnStart(): RamWebSocketListenOnStart {
            return {
                GetAll: false,
                GetById: false,
                Create: true,
                CreateMany: true,
                Update: true,
                UpdateMany: true,
                Delete: true,
                DeleteMany: true,
            };
        }

        public complete(objects?: ResourceDetails | ResourceDetails[]): RamCompletor<ResourceDetails> {
            return new RamCompletor(objects);
        }

        @BindThis()
        protected async otherGetAll(items: ResourceSimple[], params: UriParamsValue, uid?: string): Promise<void> {
            if(uid && this.otherGetAllLocked[uid]) return;

            for(let item of items) {
                await this.addOrUpdateData(item);
            }
        }
        protected override async beforeGetAll(): Promise<VoidWithError> {
            const result = new VoidWithError();
            if(!this.getAllDone) {
                let uid = uuidv4();
                this.otherGetAllLocked[uid] = true;
                const list = await result.extractAsync(() => this.routes.GetAll({ uid }));
                delete this.otherGetAllLocked[uid];
                if(!list) return result;

                for(let item of list) {
                    await result.runAsync(() => this.addOrUpdateData(item));
                }
            }
            return result;

        }

        @BindThis()
        protected async otherGetById(item: ExtractFromError<ResourceDetails>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherGetByIdLocked[uid]) return;

            await this.addOrUpdateData(item);
        }
        protected override async beforeGetById(id: number): Promise<VoidWithError> {
            const result = new VoidWithError();
            if(this.records.has(id)) {
                return result;
            }

            let uid = uuidv4();
            this.otherGetByIdLocked[uid] = true;
            const item = await result.extractAsync(() => this.routes.GetById(id));
            delete this.otherGetByIdLocked[uid];
            if(!item) return result;
            await result.runAsync(() => this.addOrUpdateData(item));
            return result;
        }
        protected override async beforeGetByIds(ids: number[]): Promise<VoidWithError> {
            const result = new VoidWithError();
            let missingIds: number[] = [];
            for(let id of ids) {
                if(!this.records.has(id)) {
                    missingIds.push(id);
                }
            }

            if(missingIds.length > 0) {
                const response = await result.extractAsync(() => this.routes.GetByIds({ ids: missingIds }));
                if(!response) return result;

                for(let item of response) {
                    await result.runAsync(() => this.addOrUpdateData(item));
                }
            }
            return result;
        }

        //#region create
        @BindThis()
        protected async otherCreateItem(item: ExtractFromError<ResourceDetails>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherCreateItemLocked[uid]) return;

            const resultTemp = await this.addOrUpdateData(item);
            if(resultTemp.success && resultTemp.result) {
                this.publish('created', resultTemp.result.value);
            }
        }


        protected override async transformCreateRequestListToItem(list: Request[]): Promise<ResultWithError<ResourceDetails[]>> {
            const uid = uuidv4();
            this.otherCreateListLocked[uid] = true;
            const result = await this.routes.CreateMany({ list });
            delete this.otherCreateListLocked[uid];
            return result as ResultWithError<ResourceDetails[]>;
        }

        protected override async transformCreateRequestToItem(item: Request): Promise<ResultWithError<ResourceDetails>> {
            const uid = uuidv4();
            this.otherCreateItemLocked[uid] = true;
            const result = await this.routes.Create({ request: item });
            delete this.otherCreateItemLocked[uid];
            return result as ResultWithError<ResourceDetails>;
        }


        @BindThis()
        protected async otherCreateList(items: ExtractFromError<ResourceDetails[]>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherCreateListLocked[uid]) return;

            for(let item of items) {
                const resultTemp = await this.addOrUpdateData(item);
                if(resultTemp.success && resultTemp.result) {
                    this.publish('created', resultTemp.result.value);
                }
            }
        }

        //#endregion

        //#region update
        @BindThis()
        protected async otherUpdateItem(item: ExtractFromError<ResourceDetails>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherUpdateItemLocked[uid]) return;

            const resultTemp = await this.addOrUpdateData(item);
            if(resultTemp.success && resultTemp.result) {
                this.publish('updated', resultTemp.result.value);
            }
        }

        protected override async transformUpdateRequestListToItem(list: Request[]): Promise<ResultWithError<ResourceDetails[]>> {
            let uid = uuidv4();
            this.otherUpdateListLocked[uid] = true;
            const result = await this.routes.UpdateMany({ list });
            delete this.otherUpdateListLocked[uid];
            return result as ResultWithError<ResourceDetails[]>;
        }
        protected override async transformUpdateRequestToItem(item: Request): Promise<ResultWithError<ResourceDetails>> {
            const result: ResultWithError<ResourceDetails> = new ResultWithError();
            const id = result.extract(() => this.getIdWithError(item));
            if(id === undefined) return result;
            let uid = uuidv4();
            this.otherUpdateItemLocked[uid] = true;
            const temp = await this.routes.Update(id, { request: item });
            delete this.otherUpdateItemLocked[uid];
            return temp as ResultWithError<ResourceDetails>;
        }


        @BindThis()
        protected async otherUpdateList(items: ExtractFromError<ResourceDetails[]>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherUpdateListLocked[uid]) return;

            for(let item of items) {
                const resultTemp = await this.addOrUpdateData(item);
                if(resultTemp.success && resultTemp.result) {
                    this.publish('updated', resultTemp.result.value);
                }
            }
        }

        //#endregion

        //#region delete
        @BindThis()
        protected otherDeleteItem(id: ExtractFromError<number>, params: UriParamsValue, uid?: string) {
            if(uid && this.otherDeleteItemLocked[uid]) return;

            const resultTemp = this.deleteData(id);
            if(resultTemp.success && resultTemp.result) {
                this.publish('deleted', resultTemp.result);
                this.recordsSubscribers.delete(id);
            }
        }
        protected override async beforeDeleteItem(item: ResourceDetails, fromList: boolean): Promise<VoidWithError> {
            const result: VoidWithError = new VoidWithError();
            if(fromList) {
                return result;
            }

            let uid = uuidv4();
            this.otherDeleteItemLocked[uid] = true;
            const id = await result.extract(() => this.getIdWithError(item));
            if(id === undefined) return result;
            await result.runAsync(() => this.routes.Delete(id, { uid }));
            delete this.otherDeleteItemLocked[uid];

            return result;
        }

        @BindThis()
        protected otherDeleteList(ids: number[], params: UriParamsValue, uid?: string) {
            if(uid && this.otherDeleteListLocked[uid]) return;

            for(let id of ids) {
                const resultTemp = this.deleteData(id);
                if(resultTemp.success && resultTemp.result) {
                    this.publish('deleted', resultTemp.result);
                    this.recordsSubscribers.delete(id);
                }

            }
        }
        protected override async beforeDeleteList(list: ResourceDetails[]): Promise<VoidWithError> {
            const result: VoidWithError = new VoidWithError();
            if(list.length == 0) return result;

            const ids: number[] = [];
            for(let item of list) {
                const id = result.extract(() => this.getIdWithError(item));
                if(id === undefined) return result;
                ids.push(id);
            }

            let uid = uuidv4();
            this.otherDeleteListLocked[uid] = true;
            await result.runAsync(() => this.routes.DeleteMany({ ids }));
            delete this.otherDeleteListLocked[uid];
            return result;
        }

        /**
        * Delete element inside Ram without firing delete event
        */
        protected deleteData(id: number): ResultWithError<RamItem<ResourceDetails, Request>> {
            const result = new ResultWithError<RamItem<ResourceDetails, Request>>();
            try {
                if(this.records.has(id)) {
                    result.result = this.records.get(id);
                    this.records.delete(id);
                }
                else {
                    result.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't delete the item " + id + " because it wasn't found inside ram"));
                }
            }
            catch(e) {
                result.errors.push(new RamError(RamErrorCode.unknow, e));
            }
            return result;
        }
        //#endregion

    };
}