<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.9.4" />
    <PackageReference Include="NUnit" Version="3.13.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.17.0" />
    <PackageReference Include="coverlet.collector" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AventusSharp.AspNetCore\AventusSharp.AspNetCore.csproj" />
    <ProjectReference Include="..\AventusSharp.Maui\AventusSharp.Maui.csproj" />
    <ProjectReference Include="..\AventusSharp.Runtime\AventusSharp.Runtime.csproj" />
    <ProjectReference Include="..\AventusSharp.Data.Sqlite\AventusSharp.Data.Sqlite.csproj" />
    <ProjectReference Include="..\AventusSharp.Data.Mysql\AventusSharp.Data.Mysql.csproj" />
    <ProjectReference Include="..\AventusSharp.Data.Postgresql\AventusSharp.Data.Postgresql.csproj" />
    <ProjectReference Include="..\AventusSharp.Data.Mssql\AventusSharp.Data.Mssql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docker-compose.databases.yml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
