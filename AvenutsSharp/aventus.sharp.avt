          "result": "WsEvent",
          "file": "./AventusJs/src/WebSocket/WsEvent.lib.avt"
        },
        "AventusSharp.WebSocket.Router": {
          "result": "Router",
          "file": "./AventusJs/src/WebSocket/Router.lib.avt"
        },
        "AventusSharp.Data.SharpClass": {
          "result": "SharpClass",
          "file": "./AventusJs/src/Data/SharpClass.lib.avt"
        },
        "AventusSharp.Tools.ResultWithError": {
          "result": "ResultWithError",
          "file": "./AventusJs/src/generated/Tools/ResultWithError.lib.avt"
        },
        "AventusSharp.Tools.VoidWithError": {
          "result": "VoidWithError",
          "file": "./AventusJs/src/generated/Tools/ResultWithError.lib.avt"
        },
        "AventusSharp.Routes.Response.Resource": {
